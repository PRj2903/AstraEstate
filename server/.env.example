# Astrra Estates Server Environment Configuration
PORT=5000
NODE_ENV=development

# Database connection:
# For MySQL: mysql://username:password@localhost:3306/astreates
# For SQLite (default development): file:./dev.db
DATABASE_URL="file:./dev.db"

# JWT Secret for Admin Authentication
JWT_SECRET="astrea-luxury-estates-jwt-secret-key-2026-secure"
JWT_EXPIRES_IN="7d"

# Client URL for CORS
CLIENT_URL="http://localhost:5173"
